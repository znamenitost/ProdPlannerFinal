        if (start < lunchEnd && end > lunchStart) {
          // Сегмент до обеда
          if (start < lunchStart) {
            const beforeLunchEnd = end < lunchStart ? end : lunchStart;
            if (beforeLunchEnd > start) {
              segments.push({
                ...segment,
                start: start,
                end: beforeLunchEnd
              });
            }
          }
          // Сегмент после обеда
          if (end > lunchEnd) {
            const afterLunchStart = start > lunchEnd ? start : lunchEnd;
            if (end > afterLunchStart) {
              segments.push({
                ...segment,
                start: afterLunchStart,
