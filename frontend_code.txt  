          return (
            <Alert 
              key={risk.taskId}
              severity={severity}
              icon={icon}
              sx={{ 
                borderRadius: 2,
                '& .MuiAlert-icon': { alignItems: 'center' }
              }}
              action={
                <IconButton size="small" onClick={() => setOpen(false)}>
                  <Close fontSize="small" />
                </IconButton>
              }
            >
              <AlertTitle sx={{ fontWeight: 600, fontSize: '0.9rem', mb: 0.5 }}>
                {title}
              </AlertTitle>
              
              <strong>{shortTitle}</strong>
              
              <Stack direction="row" alignItems="center" spacing={2} sx={{ mt: 1, fontSize: '0.8rem', color: 'text.secondary' }}>
