import React, { useState, useEffect, Fragment } from 'react';
import {
  Paper,
  Table,
  TableBody,
  TableCell,
  TableContainer,
  TableHead,
  TableRow,
  Button,
  IconButton,
  TextField,
  Select,
  MenuItem,
  FormControl,
  InputLabel,
  Stack,
  Typography,
  Tooltip,
  Chip,
  Box,
  Collapse,
  LinearProgress
} from '@mui/material';
import {
  Add,
  Delete,
  PlayArrow,
  Pause,
  CheckCircle,
  Edit,
  Save,
  Cancel,
  Error,
  FolderOpen,
  ExpandMore,
  ChevronRight,
  CallSplit,
  Person,
  Build,
  Print
} from '@mui/icons-material';
import SplitTaskModal from './SplitTaskModal';

export default function TaskTable({ refreshTrigger, onTaskUpdate }) {
  const [rows, setRows] = useState([]);
  const [editingId, setEditingId] = useState(null);
  const [newRow, setNewRow] = useState(null);
  const [expandedRows, setExpandedRows] = useState(new Set());
  const [splitModalOpen, setSplitModalOpen] = useState(false);
  const [selectedTaskForSplit, setSelectedTaskForSplit] = useState(null);
  const [employees] = useState(['Дима', 'Яромир', 'Павел']);
  const [taskTypes] = useState(['Резка', 'УФ печать', 'Монтаж', 'Дизайн']);

  useEffect(() => {
    loadRows();
  }, [refreshTrigger]);

  const loadRows = async () => {
    try {
      const response = await fetch('/api/table/rows');
      const data = await response.json();
      const grouped = groupTasksByParent(data);
      setRows(grouped);
    } catch (err) {
      console.error('Ошибка загрузки:', err);
    }
  };

  const groupTasksByParent = (tasks) => {
    const parents = tasks.filter(t => !t.parentRowNumber || t.parentRowNumber === 0 || t.parentRowNumber === null);
    const children = tasks.filter(t => t.parentRowNumber && t.parentRowNumber > 0);
    
    return parents.map(parent => ({
      ...parent,
      children: children.filter(c => c.parentRowNumber === parent.id)
    }));
  };

  const getUniqueEmployees = (children) => {
    const uniqueEmployees = new Set();
    children.forEach(child => {
      if (child.employeeName) {
        uniqueEmployees.add(child.employeeName);
      }
    });
    return Array.from(uniqueEmployees);
  };

  const toggleExpand = (rowId) => {
    const newExpanded = new Set(expandedRows);
    if (newExpanded.has(rowId)) {
      newExpanded.delete(rowId);
    } else {
      newExpanded.add(rowId);
    }
    setExpandedRows(newExpanded);
  };

  const openFile = async (row) => {
    const fullPath = row.folderPath 
      ? `${row.folderPath}/${row.fileName}`
      : row.fileName;
    
    if (!fullPath) {
      alert('Путь к файлу не указан');
      return;
    }
    
    try {
      const response = await fetch('/api/files/open', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ filePath: fullPath })
      });
      const data = await response.json();
      if (!response.ok) {
        alert(data.message || 'Ошибка открытия файла');
      }
    } catch (err) {
      console.error('Ошибка открытия файла:', err);
      alert('Не удалось открыть файл');
    }
  };

  const handleAddNewRow = () => {
    setNewRow({
      folderPath: '',
      fileName: '',
      comment: '',
      statusText: '',
      deadline: new Date().toISOString().slice(0, 16),
      estimateHours: 1,
      type: taskTypes[0],
      employeeName: employees[0],
      parentRowNumber: null
    });
  };

  const handleSaveNewRow = async () => {
    try {
      const response = await fetch('/api/table/row', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          ...newRow,
          parentRowNumber: null
        })
      });
      if (response.ok) {
        setNewRow(null);
        await loadRows();
        if (onTaskUpdate) onTaskUpdate();
      } else {
        const error = await response.json();
        console.error('Ошибка сохранения:', error);
        alert('Ошибка сохранения задачи');
      }
    } catch (err) {
      console.error('Ошибка сохранения:', err);
      alert('Ошибка сохранения задачи');
    }
  };

  const handleStartTask = async (row) => {
    try {
      await fetch(`/api/table/row/${row.id}/start`, { method: 'POST' });
      await loadRows();
      if (onTaskUpdate) onTaskUpdate();
    } catch (err) {
      console.error('Ошибка:', err);
    }
  };

  const handlePauseTask = async (row) => {
    try {
      await fetch(`/api/table/row/${row.id}/pause`, { method: 'POST' });
      await loadRows();
      if (onTaskUpdate) onTaskUpdate();
    } catch (err) {
      console.error('Ошибка:', err);
    }
  };

  const handleResumeTask = async (row) => {
    try {
      await fetch(`/api/table/row/${row.id}/resume`, { method: 'POST' });
      await loadRows();
      if (onTaskUpdate) onTaskUpdate();
    } catch (err) {
      console.error('Ошибка:', err);
    }
  };

  const handleCompleteTask = async (row) => {
    try {
      await fetch(`/api/table/row/${row.id}/complete`, { method: 'POST' });
      await loadRows();
      if (onTaskUpdate) onTaskUpdate();
    } catch (err) {
      console.error('Ошибка:', err);
    }
  };

  const handleDeleteRow = async (id) => {
    if (window.confirm('Удалить задачу?')) {
      try {
        await fetch(`/api/table/row/${id}`, { method: 'DELETE' });
        await loadRows();
        if (onTaskUpdate) onTaskUpdate();
      } catch (err) {
        console.error('Ошибка удаления:', err);
      }
    }
  };

  const handleDeleteRowWithChildren = async (parentRow) => {
    if (window.confirm(`Удалить задачу "${parentRow.fileName}" и все её части?`)) {
      try {
        for (const child of parentRow.children) {
          await fetch(`/api/table/row/${child.id}`, { method: 'DELETE' });
        }
        await fetch(`/api/table/row/${parentRow.id}`, { method: 'DELETE' });
        await loadRows();
        if (onTaskUpdate) onTaskUpdate();
      } catch (err) {
        console.error('Ошибка удаления:', err);
        alert('Ошибка удаления задачи');
      }
    }
  };

  const handleUpdateRow = async (row) => {
    try {
      const response = await fetch(`/api/table/row/${row.id}`, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(row)
      });
      if (response.ok) {
        setEditingId(null);
        await loadRows();
        if (onTaskUpdate) onTaskUpdate();
      }
    } catch (err) {
      console.error('Ошибка обновления:', err);
    }
  };

  const handleSplitTask = (row) => {
    const fetchTaskForSplit = async () => {
      try {
        const response = await fetch(`/api/tasks/active?employee=${encodeURIComponent(row.employeeName)}`);
        const tasks = await response.json();
        const task = tasks.find(t => t.rowNumber === row.id);
        if (task) {
          setSelectedTaskForSplit(task);
          setSplitModalOpen(true);
        } else {
          alert('Не удалось найти задачу для разделения');
        }
      } catch (err) {
        console.error('Ошибка:', err);
        alert('Ошибка при подготовке к разделению');
      }
    };
    fetchTaskForSplit();
  };

  const handleSplitSuccess = () => {
    loadRows();
    if (onTaskUpdate) onTaskUpdate();
  };

  const getStatusColor = (status) => {
    if (status === 'Готово') return '#22c55e';
    if (status === 'Начал') return '#3b82f6';
    if (status === 'Пауза') return '#f59e0b';
    return '#64748b';
  };

  const getStatusIcon = (status) => {
    if (status === 'Готово') return <CheckCircle sx={{ fontSize: 16 }} />;
    if (status === 'Начал') return <PlayArrow sx={{ fontSize: 16 }} />;
    if (status === 'Пауза') return <Pause sx={{ fontSize: 16 }} />;
    return null;
  };

  const getTypeIcon = (type) => {
    if (type === 'Резка') return <Build sx={{ fontSize: 14 }} />;
    if (type === 'УФ печать') return <Print sx={{ fontSize: 14 }} />;
    return null;
  };

  const isOverdue = (deadline, status) => {
    if (status === 'Готово') return false;
    return new Date(deadline) < new Date();
  };

  const getParentProgress = (parent) => {
    if (!parent.children || parent.children.length === 0) return 0;
    const completed = parent.children.filter(c => c.statusText === 'Готово').length;
    return (completed / parent.children.length) * 100;
  };

  const renderTaskRow = (task, isChild = false) => {
    const overdue = isOverdue(task.deadline, task.statusText);
    const isEditing = editingId === task.id;
    const hasChildren = task.children && task.children.length > 0;
    const isExpanded = expandedRows.has(task.id);
    const progress = hasChildren ? getParentProgress(task) : (task.statusText === 'Готово' ? 100 : 0);
    
    return (
      <Fragment key={task.id}>
        <TableRow 
          sx={{
            '&:hover': { bgcolor: '#f8fafc' },
            bgcolor: overdue && task.statusText !== 'Готово' ? '#fef2f2' : 'inherit',
            borderLeft: isChild ? '2px solid #e2e8f0' : 'none'
          }}
        >
          <TableCell>
            <Stack direction="row" alignItems="center" spacing={0.5}>
              {hasChildren && (
                <IconButton size="small" onClick={() => toggleExpand(task.id)}>
                  {isExpanded ? <ExpandMore fontSize="small" /> : <ChevronRight fontSize="small" />}
                </IconButton>
              )}
              {!hasChildren && !isChild && <Box sx={{ width: 28 }} />}
              <Tooltip title={`Открыть файл: ${task.folderPath}/${task.fileName}`} arrow>
                <IconButton 
                  size="small" 
                  onClick={() => openFile(task)}
                  sx={{ color: '#7c9ebf' }}
                >
                  <FolderOpen fontSize="small" />
                </IconButton>
              </Tooltip>
            </Stack>
          </TableCell>
          
          {isEditing ? (
            <TableCell colSpan={8}>
              <Stack direction="row" spacing={1} alignItems="center">
                <TextField
                  size="small"
                  value={task.fileName}
                  onChange={(e) => setRows(rows.map(r => r.id === task.id ? { ...r, fileName: e.target.value } : r))}
                  placeholder="Имя файла"
                />
                <TextField
                  size="small"
                  value={task.estimateHours}
                  onChange={(e) => setRows(rows.map(r => r.id === task.id ? { ...r, estimateHours: parseFloat(e.target.value) } : r))}
                  type="number"
                  sx={{ width: 80 }}
                />
                <IconButton size="small" color="primary" onClick={() => handleUpdateRow(task)}>
                  <Save fontSize="small" />
                </IconButton>
                <IconButton size="small" color="error" onClick={() => setEditingId(null)}>
                  <Cancel fontSize="small" />
                </IconButton>
              </Stack>
            </TableCell>
          ) : (
            <>
              <TableCell>
                <Stack direction="row" alignItems="center" spacing={1}>
                  {isChild && <Box sx={{ width: 24 }} />}
                  <Typography variant="body2" sx={{ fontWeight: isChild ? 400 : 600 }}>
                    {isChild ? `└─ ` : ''}{task.fileName}
                  </Typography>
                  {hasChildren && (
                    <Chip 
                      size="small" 
                      label={`Разделена на ${task.children.length}`}
                      icon={<CallSplit sx={{ fontSize: 12 }} />}
                      sx={{ height: 20, fontSize: '0.7rem', bgcolor: '#e0e7ff' }}
                    />
                  )}
                </Stack>
              </TableCell>
              <TableCell sx={{ color: 'text.secondary', fontSize: '0.8rem' }}>
                {task.comment}
              </TableCell>
              <TableCell sx={{ color: overdue ? '#dc2626' : 'inherit', fontSize: '0.8rem' }}>
                {new Date(task.deadline).toLocaleDateString()}
              </TableCell>
              <TableCell sx={{ fontSize: '0.8rem' }}>
                {task.estimateHours} ч
              </TableCell>
              <TableCell>
                <Chip 
                  icon={getTypeIcon(task.type)}
                  label={task.type} 
                  size="small"
                  variant="outlined"
                  sx={{ fontSize: '0.7rem' }}
                />
              </TableCell>
              <TableCell>
                {hasChildren ? (
                  <Tooltip title={getUniqueEmployees(task.children).join(' / ')} arrow>
                    <Chip 
                      icon={<Person sx={{ fontSize: 14 }} />}
                      label={getUniqueEmployees(task.children).join(' / ')} 
                      size="small"
                      variant="outlined"
                      sx={{ fontSize: '0.7rem', bgcolor: '#f1f5f9', maxWidth: '120px' }}
                    />
                  </Tooltip>
                ) : (
                  <Chip 
                    icon={<Person sx={{ fontSize: 14 }} />}
                    label={task.employeeName} 
                    size="small"
                    variant="outlined"
                    sx={{ fontSize: '0.7rem' }}
                  />
                )}
              </TableCell>
              <TableCell>
                {hasChildren ? (
                  progress >= 99.9 ? (
                    <Chip 
                      icon={<CheckCircle sx={{ fontSize: 16 }} />}
                      label="Готово" 
                      size="small"
                      sx={{ bgcolor: '#22c55e', color: 'white', fontSize: '0.7rem' }}
                    />
                  ) : (
                    <Box sx={{ width: 100 }}>
                      <LinearProgress 
                        variant="determinate" 
                        value={progress} 
                        sx={{ height: 6, borderRadius: 3 }}
                      />
                      <Typography variant="caption" sx={{ fontSize: '0.7rem' }}>
                        {Math.round(progress)}%
                      </Typography>
                    </Box>
                  )
                ) : (
                  <Chip 
                    icon={getStatusIcon(task.statusText)}
                    label={task.statusText || "Назначена"} 
                    size="small"
                    sx={{ bgcolor: getStatusColor(task.statusText), color: 'white', fontSize: '0.7rem' }}
                  />
                )}
              </TableCell>
              <TableCell>
                <Stack direction="row" spacing={0.5}>
                  {task.statusText !== 'Готово' && task.statusText !== 'Начал' && task.statusText !== 'Пауза' && !hasChildren && (
                    <Tooltip title="Начать">
                      <IconButton size="small" onClick={() => handleStartTask(task)} sx={{ color: '#22c55e' }}>
                        <PlayArrow fontSize="small" />
                      </IconButton>
                    </Tooltip>
                  )}
                  
                  {task.statusText === 'Начал' && !hasChildren && (
                    <>
                      <Tooltip title="Пауза">
                        <IconButton size="small" onClick={() => handlePauseTask(task)} sx={{ color: '#f59e0b' }}>
                          <Pause fontSize="small" />
                        </IconButton>
                      </Tooltip>
                      <Tooltip title="Завершить">
                        <IconButton size="small" onClick={() => handleCompleteTask(task)} sx={{ color: '#3b82f6' }}>
                          <CheckCircle fontSize="small" />
                        </IconButton>
                      </Tooltip>
                    </>
                  )}
                  
                  {task.statusText === 'Пауза' && !hasChildren && (
                    <>
                      <Tooltip title="Продолжить">
                        <IconButton size="small" onClick={() => handleResumeTask(task)} sx={{ color: '#22c55e' }}>
                          <PlayArrow fontSize="small" />
                        </IconButton>
                      </Tooltip>
                      <Tooltip title="Завершить">
                        <IconButton size="small" onClick={() => handleCompleteTask(task)} sx={{ color: '#3b82f6' }}>
                          <CheckCircle fontSize="small" />
                        </IconButton>
                      </Tooltip>
